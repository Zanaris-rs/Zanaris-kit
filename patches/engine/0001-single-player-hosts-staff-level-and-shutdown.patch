+// The same exit path as a signal, so every save is flushed. Windows has no
+// SIGTERM, so a host that supervises the world - a desktop launcher running it
+// as a child process - has no other way to stop it cleanly.
+management.post('/shutdown', async (_req, reply) => {
+    const accepted = requestShutdown(() => World.rebootTimer(0));
+    reply.status(202);
+    return { stopping: true, alreadyStopping: !accepted };
+});
